namespace NinjaTrader.NinjaScript.Strategies
{
	public class StratPreAlpha : Strategy
	{
		private const string STRATEGY_ID = "EnterEarlyIfDown_v1.0";
		
		private double closeYesterday = 0;
		private const int segmentLookback = 25;
		
		private MarketState marketState;
		private TrailingStopStrategy strategy;
		private bool initialize = false;
		
		/// <summary>
		/// The time when the strategy is allowed to enter a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(0, double.MaxValue)]
		[Display(Name = "Down Threshold", Order = 1)]
		public double DownThreshold { get; set; }
		
		/// <summary>
		/// The time when the strategy is allowed to enter a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trade Start Time", Order = 2)]
		public int TradeStart { get; set; }
		
		/// <summary>
		/// The time when the strategy is no longer allowed to enter a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trade End Time", Order = 3)]
		public int TradeEnd { get; set; }
		
		/// <summary>
		/// The starting stop-loss value when entering a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Initial Stop Loss", Order = 4)]
		public int InitialStopLoss { get; set; }
		
		/// <summary>
		/// The profit amount to trigger the logic to update the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Trigger", Order = 5)]
		public int TrailTrigger { get; set; }
		
		/// <summary>
		/// The increments used when updating the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Distance", Order = 6)]
		public int TrailDistance { get; set; }
		
		protected override void OnStateChange()
		{
			if (State == State.SetDefaults)
			{
				Description									= @"
					This strategy intends to enter the market early if it's down since the close of yesterday.
				";
				Name										= STRATEGY_ID;
				Calculate									= Calculate.OnBarClose;
				EntriesPerDirection							= 1;
				EntryHandling								= EntryHandling.AllEntries;
				IsExitOnSessionCloseStrategy				= true;
				ExitOnSessionCloseSeconds					= 30;
				IsFillLimitOnTouch							= false;
				MaximumBarsLookBack							= MaximumBarsLookBack.TwoHundredFiftySix;
				OrderFillResolution							= OrderFillResolution.Standard;
				Slippage									= 0;
				StartBehavior								= StartBehavior.WaitUntilFlat;
				TimeInForce									= TimeInForce.Gtc;
				TraceOrders									= false;
				RealtimeErrorHandling						= RealtimeErrorHandling.StopCancelClose;
				StopTargetHandling							= StopTargetHandling.PerEntryExecution;
				BarsRequiredToTrade							= 20;
				// Disable this property for performance gains in Strategy Analyzer optimizations
				// See the Help Guide for additional information
				IsInstantiatedOnEachOptimizationIteration	= true;
				
				InitialStopLoss = 10;
				TrailTrigger = 20;
				TrailDistance = 6;
				TradeStart = 80000;
				TradeEnd = 84000;
				DownThreshold = 15;
				
				strategy = new TrailingStopStrategy(InitialStopLoss, TrailTrigger, TrailDistance);
				marketState = new MarketState();
			}
			else if (State == State.Configure)
			{
			}
			else if (State == State.Terminated)
			{
				Print($"TERMINATED - CurrentStop: {strategy.CurrentStopLoss}");
			}
		}

		protected override void OnBarUpdate()
		{	
			if (Bars.IsFirstBarOfSession)
			{
				closeYesterday = Open[0];
				Print($"Close Yesterday : {closeYesterday:#.##}");
			}
			
			if (CurrentBar < segmentLookback)
				return;
			
			int currentTime = ToTime(Time[0]);
			var bars = GetBars(Time, Open, High, Low, Close, Volume, 25);
			var bar = bars.First();

			if (!initialize)
			{
				strategy.Initialize(bar);
				initialize = true;
			}
			
			marketState.OnNewBar(bar);
			var tradeWindowSignal = new InTradeWindow(TradeStart, TradeEnd);
			var barChangeSignal = new BarChange(3, 3, PriceDirection.DECREASING);
			var inTradeWindow = tradeWindowSignal.IsTriggered(bars);
			var barChange = barChangeSignal.IsTriggered(bars);
			
			Print($"Evaluating Bar : {bar.ToLog()}");
			Print($"\t{tradeWindowSignal.Log}");
			Print($"\t{barChangeSignal.Log}");
			
			if (inTradeWindow && barChange)
			{
				if (bars.All(x => x.Close < closeYesterday - DownThreshold))
				{
					EnterLong(STRATEGY_ID);
				}
			}
			
			if (Position.MarketPosition == MarketPosition.Long)
			{
				if (strategy.EvaluateStopLoss(bar))
				{
					Print($"{strategy.Log}");
					SetStopLoss(CalculationMode.Price, strategy.CurrentStopLoss);
				}
			}
		}
		
		private List<AutomatedTrading.Core.Models.Bar> GetBars(TimeSeries times,
            ISeries<double> opens,
            ISeries<double> highs,
            ISeries<double> lows,
            ISeries<double> closes,
            VolumeSeries volumes,
            int barCount = 1)
        {
            var list = new List<AutomatedTrading.Core.Models.Bar>();
            for (var i = 0; i < barCount; i++)
            {
				list.Add(new AutomatedTrading.Core.Models.Bar(ToTime(Time[i]), opens[i], highs[i], lows[i], closes[i], volumes[i]));
            }
            return list;
        }
	}
}
