//This namespace holds Strategies in this folder and is required. Do not change it.
namespace NinjaTrader.NinjaScript.Strategies
{
    /// <summary>
    /// Enters short when the session high reaches the predicted ExpectedHigh price.
    /// A fixed 25-point stop-loss is placed above the entry price.
    /// </summary>
    public class PredictSessionHighStrategy : Strategy
    {
        private bool stopLossSet = false;

        protected const string STRATEGY_ID = "PredictSessionHigh";
        private const int STOP_LOSS_POINTS = 25;

        /// <summary>
        /// The predicted session high price. The strategy will enter short when this price is touched.
        /// </summary>
        [NinjaScriptProperty]
        [Display(Name = "Expected High", Order = 1)]
        public double ExpectedHigh { get; set; }

        protected override void OnStateChange()
        {
            switch (State)
            {
                case State.SetDefaults:
                    Name = STRATEGY_ID;
                    Calculate = Calculate.OnBarClose;
                    EntriesPerDirection = 1;
                    IsExitOnSessionCloseStrategy = true;

                    ExpectedHigh = 0;
                    stopLossSet = false;
                    break;
                default:
                    break;
            }
        }

        protected override void OnBarUpdate()
        {
            int currentTime = ToTime(Time[0]);
            var bar = new AutoTradeBar(currentTime, Open[0], High[0], Low[0], Close[0], Volume[0]);

            var isDuringTradingHours = new InTradeDay().IsTriggered(new List<AutoTradeBar> { bar });

            if (!isDuringTradingHours)
                return;

            if (Position.MarketPosition == MarketPosition.Flat)
            {
                if (High[0] >= ExpectedHigh)
                {
                    EnterShort(STRATEGY_ID);
                    stopLossSet = false;
                }
            }

            if (Position.MarketPosition == MarketPosition.Short && !stopLossSet)
            {
                SetStopLoss(CalculationMode.Price, Position.AveragePrice + STOP_LOSS_POINTS);
                stopLossSet = true;
            }
        }
    }
}
