// =============================================================================
// AtrScalpStrategy.cs - NinjaTrader 8 NinjaScript Strategy
//
// Implements the ATR Scalp strategy from the Python ML pipeline.
// Two-stage filter: Random Forest base model + LightGBM meta model
// Features: 8 features computed from 1-minute ES bars
// Exits: 2.0x ATR profit target, 1.0x ATR stop loss, 30-min timeout
//
// REQUIREMENTS:
//   1. Microsoft.ML.OnnxRuntime managed + native DLLs in NinjaTrader's
//      Documents\NinjaTrader 8\bin\Custom\ folder
//   2. Exported ONNX base model  (atr_scalp_model.onnx)
//   3. Exported ONNX meta model  (atr_scalp_meta_model.onnx)
//   4. Exported scaler file      (atr_scalp_scaler.csv)
//   Run export_for_ninjatrader.py to produce all three files.
//
// TWO-STAGE INFERENCE:
//   Stage 1: Base RF predicts P(profitable) - gate at 0.5
//   Stage 2: Meta LightGBM confirms - gate at threshold (default 0.60)
//   The meta model receives 9 features: 8 scaled features + base probability.
//   If no meta model is loaded, falls back to single-stage (base >= threshold).
//
// DIRECTION:
//   Default is Long (matches pipeline default direction=1).
//   "Both" mode uses 5-bar close momentum to choose long vs short per bar,
//   matching the pipeline's evaluate_oos(direction=0) logic.
//
// FEATURE PARITY:
//   All 8 feature computations match the Delphi TUnifiedFeatureExtractor.
//   See inline comments for exact formula references.
// =============================================================================

#region Using declarations
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.Globalization;
using System.IO;
using System.Linq;
using NinjaTrader.Cbi;
using NinjaTrader.Data;
using NinjaTrader.NinjaScript;
using NinjaTrader.NinjaScript.Indicators;
using NinjaTrader.NinjaScript.Strategies;

using System.Net.Http;
using System.Threading.Tasks;
using Newtonsoft.Json;
using AutomatedTrading.Core.Models;
#endregion

namespace NinjaTrader.NinjaScript.Strategies
{
    public class AtrScalpStrategy : Strategy
    {
        // =====================================================================
        // Constants
        // =====================================================================
        private const double DefaultThreshold  = 0.60;
        private const double BaseGate          = 0.5;  // base model minimum gate
        private const double PtMultiplier      = 2.0;  // profit target = 2.0 x ATR
        private const double SlMultiplier      = 1.0;  // stop loss     = 1.0 x ATR
        private const int    TimeoutMinutes    = 30;
        private const int    AtrPeriod         = 14;
        private const int    ReturnLookback    = 120;
        private const int    MomentumLookback  = 5;    // for Direction=Both
        private const string AUTOMATED_TRADING_ENDPOINT = "http://localhost:5244";

        // Feature order (must match training - alphabetical from config)
        // 0: 1m_ATR_SessionPhase_Prod   ATR(14) * SessionPhase
        // 1: 1m_BodyToRange             |Close-Open| / (High-Low + 0.0001)
        // 2: 1m_DistFromSessionHigh     (SessionHigh - Close) / SessionRange
        // 3: 1m_Price_ZScore_10         (Close - Mean10) / StdDev10
        // 4: 1m_Return_120              (Close - Close[120]) / Close[120]
        // 5: 1m_SessionPhase            elapsed fraction of 23h session [0,1]
        // 6: 1m_TradeCount              tick count in this 1-min bar
        // 7: 1m_Volume_Accel            V[0] - 2*V[1] + V[2]

        // =====================================================================
        // User parameters
        // =====================================================================

        [NinjaScriptProperty]
        [Range(0.50, 0.95)]
        [Display(Name = "Signal Threshold", Description = "Min probability to enter (applied to meta model, or base if no meta)",
                 Order = 1, GroupName = "Model")]
        public double Threshold { get; set; }

        [NinjaScriptProperty]
        [Range(1, 10)]
        [Display(Name = "Contracts", Description = "Number of contracts to trade",
                 Order = 2, GroupName = "Trade Management")]
        public int Quantity { get; set; }

        [NinjaScriptProperty]
        [Display(Name = "Trade Direction", Description = "Long (default, matches backtested OOS), Short, or Both (5-bar momentum)",
                 Order = 3, GroupName = "Trade Management")]
        public ScalpDirection Direction { get; set; }

        // =====================================================================
        // Indicators
        // =====================================================================
        private ATR atr;

        // =====================================================================
        // Session tracking
        // =====================================================================
        private double sessionHigh;
        private double sessionLow;

        // =====================================================================
        // Entry tracking (for timeout)
        // =====================================================================
        private DateTime entryTime;

        // =====================================================================
        // Tick count tracking (secondary 1-tick series)
        // =====================================================================
        private int tickCountThisBar;
        private int lastBarIndex;

        // =====================================================================
        // Lifecycle
        // =====================================================================
        protected override void OnStateChange()
        {
            if (State == State.SetDefaults)
            {
                Description  = "ATR Scalp ML Strategy (Two-Stage: RF + LightGBM)";
                Name         = "AtrScalpStrategy";
                Calculate    = Calculate.OnBarClose;
                EntriesPerDirection       = 1;
                EntryHandling             = EntryHandling.AllEntries;
                IsExitOnSessionCloseStrategy = true;
                ExitOnSessionCloseSeconds = 30;
                IsFillLimitOnTouch        = false;
                MaximumBarsLookBack       = MaximumBarsLookBack.TwoHundredFiftySix;
                OrderFillResolution       = OrderFillResolution.Standard;
                BarsRequiredToTrade       = 130;  // 120 for Return_120 + warmup

                Threshold     = DefaultThreshold;
                Quantity      = 1;
                Direction     = ScalpDirection.Long;  // matches pipeline default (direction=1)
            }
            else if (State == State.Configure)
            {
                // Add a 1-tick series to count trades per 1-min bar
                AddDataSeries(BarsPeriodType.Tick, 1);
            }
            else if (State == State.DataLoaded)
            {
                atr = ATR(AtrPeriod);
                using var client = new HttpClient();
                var response = client.PostAsync($"{AUTOMATED_TRADING_ENDPOINT}/loadmodels", null).GetAwaiter().GetResult();
                //var result = response.Content.ReadAsStreamAsync().GetAwaiter().GetResult();

                sessionHigh      = double.MinValue;
                sessionLow       = double.MaxValue;
                lastBarIndex     = -1;
                tickCountThisBar = 0;
            }
            else if (State == State.Terminated)
            {
                using var client = new HttpClient();
                var response = client.PostAsync($"{AUTOMATED_TRADING_ENDPOINT}/end", null).GetAwaiter().GetResult();
                //var result = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                
            }
        }

        // =====================================================================
        // Bar update
        // =====================================================================
        protected override void OnBarUpdate()
        {
            // --- Tick series (BarsInProgress == 1): count ticks per minute bar ---
            if (BarsInProgress == 1)
            {
                int primaryBar = CurrentBars[0];
                if (primaryBar != lastBarIndex)
                {
                    tickCountThisBar = 0;
                    lastBarIndex = primaryBar;
                }
                tickCountThisBar++;
                return;
            }

            // --- Primary 1-min series (BarsInProgress == 0) only ---
            if (BarsInProgress != 0)
                return;

            // ----- Session tracking (must run on EVERY bar, before warmup guard) -----
            if (Bars.IsFirstBarOfSession)
            {
                sessionHigh = High[0];
                sessionLow  = Low[0];
            }
            else
            {
                if (High[0] > sessionHigh) sessionHigh = High[0];
                if (Low[0]  < sessionLow) sessionLow  = Low[0];
            }

            // ----- Warmup guard -----
            if (CurrentBar < BarsRequiredToTrade)
                return;

            // ----- Timeout exit -----
            if (Position.MarketPosition != MarketPosition.Flat)
            {
                if ((Time[0] - entryTime).TotalMinutes >= TimeoutMinutes)
                {
                    if (Position.MarketPosition == MarketPosition.Long)
                        ExitLong("Timeout");
                    else
                        ExitShort("Timeout");
                    return;
                }
            }
            
            using var client = new HttpClient();
            var baseSessionLoaded = 
				client.PostAsync($"{AUTOMATED_TRADING_ENDPOINT}/sessionLoaded", null).GetAwaiter().GetResult()
                    .Content.ReadAsStringAsync().GetAwaiter().GetResult();
			
            var scalerLoaded = 
                client.PostAsync($"{AUTOMATED_TRADING_ENDPOINT}/scalerLoaded", null).GetAwaiter().GetResult()
                    .Content.ReadAsStringAsync().GetAwaiter().GetResult();

            // ----- Guard: base model must be loaded -----
            if (baseSessionLoaded.Trim().ToLower() != "true" || scalerLoaded.Trim().ToLower() != "true")
                return;

            // ----- Only enter when flat -----
            if (Position.MarketPosition != MarketPosition.Flat)
                return;
			
            // ----- Compute features -----
            var volumeAccel = CurrentBar >= 2 ? Volume[0] - 2.0 * Volume[1] + Volume[2] : 0;
			var featuresRequest = new ComputeFeaturesRequest(
                Time[0],
                atr[0],
                volumeAccel,
                sessionHigh,
                sessionLow,
                tickCountThisBar,
                GetBars(Time, Open, High, Low, Close, Volume, ReturnLookback + 1));
			
            var featuresResponse = client.PostAsync(
				$"{AUTOMATED_TRADING_ENDPOINT}/computeFeatures", 
				new StringContent(
					JsonConvert.SerializeObject(featuresRequest), 
					System.Text.Encoding.UTF8, 
					"application/json"))
				.GetAwaiter().GetResult();
			
            double[] raw = JsonConvert.DeserializeObject<FeaturesResponse>(
				featuresResponse.Content.ReadAsStringAsync().GetAwaiter().GetResult()).Features;

            if (raw == null)
                return;
            // ----- Scale features -----
            var scaledResponse = client.PostAsync(
				$"{AUTOMATED_TRADING_ENDPOINT}/scaleFeatures", 
				new StringContent(
					JsonConvert.SerializeObject(new FeaturesRequest(raw)), 
					System.Text.Encoding.UTF8, 
					"application/json"))
				.GetAwaiter()
				.GetResult();
            double[] scaled = JsonConvert.DeserializeObject<FeaturesResponse>(
				scaledResponse.Content.ReadAsStringAsync().GetAwaiter().GetResult()).Features;

            // ----- Two-stage ML filter -----
            // Stage 1: Base model (Random Forest) - gate at 0.5
            var baseInferenceResponse = client.PostAsync(
				$"{AUTOMATED_TRADING_ENDPOINT}/runBaseInference", 
				new StringContent(
					JsonConvert.SerializeObject(new FeaturesRequest(scaled)),
					System.Text.Encoding.UTF8,
					"application/json"))
				.GetAwaiter().GetResult();
            double baseProbability = JsonConvert.DeserializeObject<InferenceResponse>(baseInferenceResponse.Content.ReadAsStringAsync().GetAwaiter().GetResult()).Result;
            if (baseProbability < BaseGate)
                return;
			
            var metaSessionLoadedResponse = client.PostAsync(
				$"{AUTOMATED_TRADING_ENDPOINT}/metaSessionLoaded", null)
				.GetAwaiter().GetResult();
			
            var metaSessionLoaded = metaSessionLoadedResponse.Content.ReadAsStringAsync().GetAwaiter().GetResult();
			Print($"metaSessionLoaded : {metaSessionLoaded}");

            // Stage 2: Meta model (LightGBM) - gate at threshold
            if (metaSessionLoaded == "true")
            {
                var metaInferenceResponse = client.PostAsync(
					$"{AUTOMATED_TRADING_ENDPOINT}/runMetaInference", 
					new StringContent(
						JsonConvert.SerializeObject(new MetaInferenceRequest(scaled, baseProbability)),
						System.Text.Encoding.UTF8,
						"application/json"))					
					.GetAwaiter().GetResult();
                double metaProbability = JsonConvert.DeserializeObject<InferenceResponse>(metaInferenceResponse.Content.ReadAsStringAsync().GetAwaiter().GetResult()).Result;
                if (metaProbability < Threshold)
                    return;
            }
            else
            {
                // No meta model loaded: use base probability against threshold
                if (baseProbability < Threshold)
                    return;
            }

            // ----- Determine trade direction -----
            int tradeDirection = 0;

            if (Direction == ScalpDirection.Long)
            {
                tradeDirection = 1;
            }
            else if (Direction == ScalpDirection.Short)
            {
                tradeDirection = -1;
            }
            else  // ScalpDirection.Both
            {
                // 5-bar close momentum: matches pipeline's Close.diff(5)
                // Positive momentum → long, negative → short
                if (CurrentBar >= MomentumLookback)
                {
                    double momentum = Close[0] - Close[MomentumLookback];
                    if (momentum > 0)
                        tradeDirection = 1;
                    else if (momentum < 0)
                        tradeDirection = -1;
                    // momentum == 0 → skip (tradeDirection stays 0)
                }
            }

            if (tradeDirection == 0)
                return;

            // ----- Set exits and enter -----
            double atrVal  = atr[0];
            double ptTicks = atrVal * PtMultiplier / TickSize;
            double slTicks = atrVal * SlMultiplier / TickSize;

            if (tradeDirection == 1)
            {
                // Set exits BEFORE entry (NinjaTrader requirement)
                SetProfitTarget("AtrScalpL", CalculationMode.Ticks, ptTicks);
                SetStopLoss("AtrScalpL", CalculationMode.Ticks, slTicks, false);
                EnterLong(Quantity, "AtrScalpL");
                entryTime = Time[0];
            }
            else
            {
                SetProfitTarget("AtrScalpS", CalculationMode.Ticks, ptTicks);
                SetStopLoss("AtrScalpS", CalculationMode.Ticks, slTicks, false);
                EnterShort(Quantity, "AtrScalpS");
                entryTime = Time[0];
            }
        }
        
        private List<AutomatedTrading.Core.Models.Bar> GetBars(TimeSeries times,
            ISeries<double> opens,
            ISeries<double> highs,
            ISeries<double> lows,
            ISeries<double> closes,
            VolumeSeries volumes,
            int barCount = 1)
        {
            var list = new List<AutomatedTrading.Core.Models.Bar>();
            for (var i = 0; i < barCount; i++)
            {
                var bar = new AutomatedTrading.Core.Models.Bar(ToTime(Time[i]), opens[i], highs[i], lows[i], closes[i], volumes[i]);
                list.Add(bar);
            }
            return list;
        }
    }

    // =====================================================================
    // Direction enum (at namespace level for NinjaTrader serialization)
    // =====================================================================
    public enum ScalpDirection
    {
        Long,
        Short,
        Both
    }
}
