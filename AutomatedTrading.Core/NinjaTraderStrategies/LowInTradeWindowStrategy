//This namespace holds Strategies in this folder and is required. Do not change it. 
namespace NinjaTrader.NinjaScript.Strategies
{
	public class LowInTradeWindowStrategy : Strategy
	{
		private bool strategyInitialized = false;
		private LowInTradeWindow strategy;
		
		protected const string STRATEGY_ID = "LowInTradeWindow";
		
		/// <summary>
		/// The time when the strategy is allowed to enter a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trade Start Time", Order = 1)]
		public int TradeStart { get; set; }
		
		/// <summary>
		/// The time when the strategy is no longer allowed to enter a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trade End Time", Order = 2)]
		public int TradeEnd { get; set; }
		
		/// <summary>
		/// The starting stop-loss value when entering a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Initial Stop Loss", Order = 3)]
		public int InitialStopLoss { get; set; }
		
		/// <summary>
		/// The profit amount to trigger the logic to update the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Trigger", Order = 4)]
		public int TrailTrigger { get; set; }
		
		/// <summary>
		/// The increments used when updating the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Distance", Order = 5)]
		public int TrailDistance { get; set; }
		
		protected override void OnStateChange() 
		{
			switch (State)
			{
				case State.SetDefaults:
					Name = STRATEGY_ID;
					Calculate = Calculate.OnBarClose;
					EntriesPerDirection = 1;
					IsExitOnSessionCloseStrategy = true;
					
					TradeStart = 90000;
					TradeEnd = 140000;
					InitialStopLoss = 10;
					TrailTrigger = 50;
					TrailDistance = 5;
					
					strategy = new LowInTradeWindow(TradeStart, TradeEnd, InitialStopLoss, TrailTrigger, TrailDistance);
					strategyInitialized = false;
					break;
				case State.Terminated:
					var summary = LogBuilder.GetSessionSummaryLog(strategy.MarketState);
					if (!string.IsNullOrEmpty(summary))
						Print(summary);
					break;
				default:
					break;
			}
		}

		protected override void OnBarUpdate()
		{
			int currentTime = ToTime(Time[0]);
			var bar = new AutoTradeBar(currentTime, Open[0], High[0], Low[0], Close[0], Volume[0]);

			var isDuringTradingHours = new InTradeDay().IsTriggered(new List<AutoTradeBar> { bar });
			
			if (!isDuringTradingHours)
				return;
			
			if (!strategyInitialized)
			{
				strategy.Initialize(bar);
				strategyInitialized = true;
			}
			
			if (Position.MarketPosition == MarketPosition.Flat && strategy.Evaluate(bar))
			{
				EnterLong(STRATEGY_ID);
			}
			
			if (!string.IsNullOrEmpty(strategy.Log))
			{
				Print(strategy.Log);
			}
			
			if (Position.MarketPosition == MarketPosition.Long)
			{
				if (strategy.EvaluateStopLoss(bar, Position.AveragePrice))
				{
					SetStopLoss(CalculationMode.Price, strategy.CurrentStopLoss);
				}
			}
		}
	}
}
