namespace NinjaTrader.NinjaScript.Strategies
{
	public class ThreeRedBarsTenPointDropStrategy : Strategy
	{
		private ThreeRedBarsTenPointDrop strategy;
		private bool strategyInitialized;
		
		protected const string STRATEGY_ID = "ThreeRedBarsTenPoints";
		
		/// <summary>
		/// The starting stop-loss value when entering a trade.
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Initial Stop Loss", Order = 1)]
		public int InitialStopLoss { get; set; }
		
		/// <summary>
		/// The profit amount to trigger the logic to update the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Trigger", Order = 2)]
		public int TrailTrigger { get; set; }
		
		/// <summary>
		/// The increments used when updating the stop-loss amount. 
		/// </summary>
		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "Trail Distance", Order = 3)]
		public int TrailDistance { get; set; }
		
		protected override void OnStateChange()
		{
			switch (State)
			{
				case State.SetDefaults:
					Name = STRATEGY_ID;
					Calculate = Calculate.OnBarClose;
					EntriesPerDirection = 1;
					IsExitOnSessionCloseStrategy = true;
					
					InitialStopLoss = 10;
					TrailTrigger = 5;
					TrailDistance = 2;
					
					strategy = new ThreeRedBarsTenPointDrop(InitialStopLoss, TrailTrigger, TrailDistance);
					strategyInitialized = false;
					break;
				case State.Terminated:
					var summary = strategy.GetSessionSummaryLog();
					if (!string.IsNullOrEmpty(summary))
						Print(summary);
					break;
				default:
					break;
			}
		}

		protected override void OnBarUpdate()
		{
			int currentTime = ToTime(Time[0]);
			var bars = new List<AutoTraderBar>
			{
				new AutoTradeBar(currentTime, Open[0], High[0], Low[0], Close[0], Volume[0]),
				new AutoTradeBar(currentTime, Open[1], High[1], Low[1], Close[1], Volume[1]),
				new AutoTradeBar(currentTime, Open[2], High[2], Low[2], Close[2], Volume[2]),
				new AutoTradeBar(currentTime, Open[3], High[3], Low[3], Close[3], Volume[3]),
				new AutoTradeBar(currentTime, Open[4], High[4], Low[4], Close[4], Volume[4]),
			};
			
			var isDuringTradingHours = new InTradeDay().IsTriggered(new List<AutoTradeBar> { bar });
			
			if (!isDuringTradingHours)
				return;
			
			if (!strategyInitialized)
			{
				strategy.Initialize(bar);
				strategyInitialized = true;
			}
			
			if (Position.MarketPosition == MarketPosition.Flat && strategy.Evaluate(bar))
			{
				EnterLong(STRATEGY_ID);
			}
			
			if (!string.IsNullOrEmpty(strategy.Log))
			{
				Print(strategy.Log);
			}
			
			if (Position.MarketPosition == MarketPosition.Long)
			{
				if (strategy.EvaluateStopLoss(bar))
				{
					SetStopLoss(CalculationMode.Price, strategy.CurrentStopLoss);
				}
			}
		}
	}
}
