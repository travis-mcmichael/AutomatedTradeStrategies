@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home Page";
}

<ul class="nav nav-tabs mb-3" id="homeTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home-pane" type="button" role="tab" aria-controls="home-pane" aria-selected="true">Home</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="trade-data-tab" data-bs-toggle="tab" data-bs-target="#trade-data-pane" type="button" role="tab" aria-controls="trade-data-pane" aria-selected="false">Trade Data</button>
    </li>
</ul>
<div class="tab-content" id="homeTabsContent">
    <div class="tab-pane fade show active" id="home-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="mb-0">Models</h2>
            <button type="button" class="btn btn-sm btn-outline-primary" id="models-add"><i class="bi bi-plus-lg"></i> Add Model</button>
        </div>
        <div id="models-table"></div>
    </div>
    <div class="tab-pane fade" id="trade-data-pane" role="tabpanel" aria-labelledby="trade-data-tab" tabindex="0">
        <div class="mb-3">
            <label for="bar-data-instrument" class="form-label">Instrument</label>
            <select id="bar-data-instrument" class="form-select" style="max-width: 240px;"></select>
        </div>
        <div id="bar-data-dropzone" class="bar-data-dropzone text-center text-muted p-4 mb-3 rounded">
            Drag and drop NinjaTrader bar export files here to import
            <div id="bar-data-dropzone-status" class="mt-2 small"></div>
        </div>
        <h2>BarData — Last 30 Trading Days</h2>
        <div id="bar-data-table"></div>
    </div>
</div>

<div class="modal fade" id="model-edit-modal" tabindex="-1" aria-labelledby="model-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="model-edit-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="model-edit-title">Edit Model</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" />
                <!-- Generated from appsettings + the fields below (see setGeneratedLocations); not user-editable. -->
                <input type="hidden" name="featureLocation" />
                <input type="hidden" name="outputLocation" />
                <div class="row g-3">
                    <div class="col-md-9">
                        <label for="model-edit-modelName" class="form-label">Model Name</label>
                        <input type="text" class="form-control" id="model-edit-modelName" name="modelName" required />
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-instrument" class="form-label">Instrument</label>
                        <input type="text" class="form-control" id="model-edit-instrument" name="instrument" required />
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-target" class="form-label">Target</label>
                        <select class="form-select" id="model-edit-target" name="target" required>
                            <option value="" disabled hidden>Select...</option>
                            <option value="HIGH">HIGH</option>
                            <option value="LOW">LOW</option>
                            <option value="CLASS">CLASS</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-barType" class="form-label">Bar Type</label>
                        <select class="form-select" id="model-edit-barType" name="barType" required>
                            <option value="" disabled hidden>Select...</option>
                            <option value="session">session</option>
                            <option value="window">window</option>
                            <option value="minute">minute</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-windowStart" class="form-label">Window Start</label>
                        <input type="text" class="form-control" id="model-edit-windowStart" name="windowStart" pattern="\d{5,6}" placeholder="HHmmss" />
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-windowEnd" class="form-label">Window End</label>
                        <input type="text" class="form-control" id="model-edit-windowEnd" name="windowEnd" pattern="\d{5,6}" placeholder="HHmmss" />
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-trainingStart" class="form-label">Training Start</label>
                        <input type="text" class="form-control" id="model-edit-trainingStart" name="trainingStart" pattern="\d{8}" placeholder="yyyyMMdd" required />
                    </div>
                    <div class="col-md-3">
                        <label for="model-edit-trainingEnd" class="form-label">Training End</label>
                        <input type="text" class="form-control" id="model-edit-trainingEnd" name="trainingEnd" pattern="\d{8}" placeholder="yyyyMMdd" required />
                    </div>
                    <div class="col-md-6 d-flex align-items-end gap-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="model-edit-active" name="active" />
                            <label for="model-edit-active" class="form-check-label">Active</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="model-edit-export" name="export" />
                            <label for="model-edit-export" class="form-check-label">Export</label>
                        </div>
                    </div>
                </div>
                <div id="model-edit-error" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary me-auto" id="model-edit-features">Edit Features</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="model-edit-save">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="features-edit-modal" tabindex="-1" aria-labelledby="features-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <form class="modal-content" id="features-edit-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="features-edit-title">Edit Features</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="features-add"><i class="bi bi-plus-lg"></i> Add Feature</button>
                </div>
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width: 3rem;">#</th>
                            <th>Feature</th>
                            <th>Name</th>
                            <th>Source</th>
                            <th>Parameters</th>
                            <th style="width: 2.5rem;"><span class="visually-hidden">Remove</span></th>
                        </tr>
                    </thead>
                    <tbody id="features-edit-rows"></tbody>
                </table>
                <div id="features-edit-error" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <span id="features-edit-pending" class="me-auto small text-danger d-none"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="features-edit-save">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="delete-model-modal" tabindex="-1" aria-labelledby="delete-model-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-model-title">Delete Model</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Delete <strong id="delete-model-name"></strong>?</p>
                <p class="mb-0 text-muted small" id="delete-model-details"></p>
                <div id="delete-model-error" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="delete-model-confirm">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="export-modal" tabindex="-1" aria-labelledby="export-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="export-title">Export Features</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="export-running" class="d-flex align-items-center gap-3">
                    <div class="spinner-border text-primary flex-shrink-0" role="status" aria-hidden="true"></div>
                    <div>
                        <div id="export-message"></div>
                        <div class="small text-muted">Elapsed: <span id="export-elapsed">0:00</span></div>
                    </div>
                </div>
                <div id="export-result" class="alert mb-0 d-none" role="alert"></div>
                <div class="small text-muted mt-3" id="export-note">You can close this window; the export keeps running.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bar-data-dropzone {
        border: 2px dashed #adb5bd;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .bar-data-dropzone.bar-data-dropzone-active {
        background-color: #eef6ff;
        border-color: #0d6efd;
    }
</style>

@section Scripts
{
    <script>
        const columns = [
            {
                title: '', field: 'paramsMismatch', hozAlign: 'center', width: 40, headerSort: false,
                // Flags a model where any feature's param count differs from its feature type's param count.
                mutator: (value, data) => (data.modelFeatures ?? []).some(f =>
                    (f.featureType?.featureTypeParams?.length ?? 0) !== (f.modelFeatureParams?.length ?? 0)),
                formatter: (cell) => cell.getValue()
                    ? "<i class='bi bi-exclamation-circle-fill text-danger' title='Feature parameters do not match their feature type'></i>"
                    : ''
            },
            { title: 'Model', field: 'modelName' },
            { title: 'Version', field: 'version' },
            { title: 'Instrument', field: 'instrument' },
            { title: 'Target', field: 'target' },
            { title: 'Bar Type', field: 'barType' },
            { title: 'Features', field: 'featureCount', hozAlign: 'right', mutator: (value, data) => data.modelFeatures?.length ?? 0 },
            {
                title: 'Export Features', field: 'featuresExported', hozAlign: 'center', headerSort: false,
                formatter: (cell) => {
                    if (cell.getValue())
                        return "<i class='bi bi-check-lg text-success fs-5' title='features.csv is present'></i>";
                    // Disabled buttons don't show tooltips, so the explanation goes on a wrapping span.
                    const model = cell.getRow().getData();
                    const reason = !(model.modelFeatures?.length) ? 'Add features (Edit > Edit Features) before exporting'
                        : hasMissingParams(model) ? 'Set all feature parameter values (Edit > Edit Features) before exporting'
                        : null;
                    return reason
                        ? `<span class='d-inline-block' tabindex='0' title='${reason}'><button type='button' class='btn btn-sm btn-outline-primary' disabled style='pointer-events: none;'>Export</button></span>`
                        : "<button type='button' class='btn btn-sm btn-outline-primary'>Export</button>";
                },
                cellClick: (e, cell) => {
                    if (!cell.getValue() && e.target.closest('button:not([disabled])')) startFeatureExport(cell.getRow().getData());
                }
            },
            Defaults.grid.buildEditColumn('id', (data) => openModelEditor(data)),
            {
                title: '', field: 'id', hozAlign: 'center', width: Defaults.grid.editColumnWidth, headerSort: false,
                formatter: () => "<button type='button' class='btn btn-sm btn-outline-danger' title='Delete'><i class='bi bi-trash'></i></button>",
                cellClick: (e, cell) => {
                    if (e.target.closest('button')) confirmDeleteModel(cell.getRow().getData());
                }
            }
        ];
        const table = Defaults.grid.buildGrid('#models-table', columns, '/Home/Models');

        document.getElementById('models-add').addEventListener('click', () => openModelEditor(null));

        const deleteModelModal = new bootstrap.Modal(document.getElementById('delete-model-modal'));
        const deleteModelConfirm = document.getElementById('delete-model-confirm');
        const deleteModelError = document.getElementById('delete-model-error');
        let modelPendingDelete = null;

        // Nothing is deleted until the user confirms in the popup.
        function confirmDeleteModel(model) {
            modelPendingDelete = model;
            const features = model.modelFeatures ?? [];
            const params = features.reduce((sum, f) => sum + (f.modelFeatureParams?.length ?? 0), 0);
            document.getElementById('delete-model-name').textContent = model.modelName;
            document.getElementById('delete-model-details').textContent =
                `This permanently deletes the model along with its ${features.length} feature${features.length === 1 ? '' : 's'} ` +
                `and ${params} parameter value${params === 1 ? '' : 's'}. It can't be undone. Exported files on disk are not removed.`;
            deleteModelError.classList.add('d-none');
            deleteModelConfirm.disabled = false;
            deleteModelModal.show();
        }

        deleteModelConfirm.addEventListener('click', async () => {
            if (!modelPendingDelete) return;
            deleteModelConfirm.disabled = true;
            deleteModelError.classList.add('d-none');
            try {
                const res = await fetch(`/Home/DeleteModel/${modelPendingDelete.id}`, { method: 'POST' });
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);
                modelPendingDelete = null;
                deleteModelModal.hide();
                table.replaceData();
            } catch (err) {
                deleteModelError.textContent = `Delete failed: ${err.message}`;
                deleteModelError.classList.remove('d-none');
                deleteModelConfirm.disabled = false;
            }
        });

        // True if any of the model's features lacks a value for one of its feature type's params.
        function hasMissingParams(model) {
            return (model.modelFeatures ?? []).some(f =>
                (f.featureType?.featureTypeParams ?? []).some(tp =>
                    !(f.modelFeatureParams ?? []).some(p => p.featureTypeParamId === tp.id)));
        }

        const modelEditModal = new bootstrap.Modal(document.getElementById('model-edit-modal'));
        const modelEditForm = document.getElementById('model-edit-form');
        const modelEditError = document.getElementById('model-edit-error');
        const modelEditSave = document.getElementById('model-edit-save');

        const featureLocationBase = @Json.Serialize(Configuration["featureLocation"]);
        const outputLocation = @Json.Serialize(Configuration["outputLocation"]);

        function setGeneratedLocations() {
            const f = modelEditForm.elements;
            f.featureLocation.value = `${featureLocationBase}/${f.instrument.value.trim()}.${f.barType.value}.${f.target.value}`;
            f.outputLocation.value = outputLocation;
        }

        // Row data for the model open in the editor; refreshed after feature params are saved.
        let currentModel = null;

        // data is null when adding a new model; it's created on Save, after which features can be added.
        function openModelEditor(data) {
            currentModel = data;
            for (const el of modelEditForm.elements) {
                if (!el.name) continue;
                if (el.type === 'checkbox') el.checked = !!data?.[el.name];
                else el.value = data?.[el.name] ?? '';
            }
            document.getElementById('model-edit-title').textContent = data ? `Edit Model: ${data.modelName}` : 'New Model';
            const editFeatures = document.getElementById('model-edit-features');
            editFeatures.disabled = !data;
            editFeatures.title = data ? '' : 'Save the new model before adding features';
            modelEditForm.classList.remove('was-validated');
            modelEditError.classList.add('d-none');
            modelEditModal.show();
        }

        modelEditForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            modelEditForm.classList.add('was-validated');
            if (!modelEditForm.checkValidity()) return;
            setGeneratedLocations();

            const payload = {};
            for (const el of modelEditForm.elements) {
                if (!el.name) continue;
                if (el.type === 'checkbox') payload[el.name] = el.checked;
                else if (el.name === 'id') payload.id = Number(el.value);
                else payload[el.name] = el.value.trim() === '' ? null : el.value.trim();
            }

            modelEditSave.disabled = true;
            modelEditError.classList.add('d-none');
            try {
                const res = await fetch(payload.id ? '/Home/UpdateModel' : '/Home/CreateModel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);

                modelEditModal.hide();
                table.replaceData();
            } catch (err) {
                modelEditError.textContent = `Save failed: ${err.message}`;
                modelEditError.classList.remove('d-none');
            } finally {
                modelEditSave.disabled = false;
            }
        });

        const featuresEditModalEl = document.getElementById('features-edit-modal');
        const featuresEditModal = new bootstrap.Modal(featuresEditModalEl);
        const featuresEditForm = document.getElementById('features-edit-form');
        const featuresEditRows = document.getElementById('features-edit-rows');
        const featuresEditError = document.getElementById('features-edit-error');
        const featuresEditSave = document.getElementById('features-edit-save');

        // Bootstrap doesn't support stacked modals, so the model editor is hidden while the features
        // editor is open and shown again (with any unsaved edits intact) when it closes.
        document.getElementById('model-edit-features').addEventListener('click', () => {
            document.getElementById('model-edit-modal').addEventListener('hidden.bs.modal', () => openFeaturesEditor(currentModel), { once: true });
            modelEditModal.hide();
        });
        featuresEditModalEl.addEventListener('hidden.bs.modal', () => modelEditModal.show());

        const featuresEditPending = document.getElementById('features-edit-pending');
        const featuresAddButton = document.getElementById('features-add');
        // Features removed in the editor; only deleted from the database when the editor is saved.
        let removedFeatureIds = new Set();
        // New rows get negative temp ids, which their param inputs reference until the server assigns real ids.
        let nextTempFeatureId = -1;
        let featureTypesPromise = null;
        const FEATURE_SOURCES = [['', 'daily'], ['prevMinute', 'prevMinute'], ['currMinute', 'currMinute']];

        function loadFeatureTypes() {
            featureTypesPromise ??= fetch('/Home/FeatureTypes').then(async res => {
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);
                return (await res.json()).sort((a, b) => a.name.localeCompare(b.name));
            });
            featureTypesPromise.catch(() => featureTypesPromise = null);
            return featureTypesPromise;
        }

        function openFeaturesEditor(model) {
            document.getElementById('features-edit-title').textContent = `Edit Features: ${model.modelName}`;
            featuresEditRows.replaceChildren();
            removedFeatureIds = new Set();
            nextTempFeatureId = -1;

            const features = [...(model.modelFeatures ?? [])].sort((a, b) => a.sortOrder - b.sortOrder);
            if (!features.length) {
                const row = featuresEditRows.insertRow();
                row.className = 'features-empty-row';
                const cell = row.insertCell();
                cell.colSpan = 6;
                cell.className = 'text-muted';
                cell.textContent = 'This model has no features.';
            }
            features.forEach(feature => addFeatureRow(feature));

            featuresEditForm.classList.remove('was-validated');
            featuresEditError.classList.add('d-none');
            refreshFeatureRows();
            featuresEditModal.show();
        }

        // Builds a table row for an existing feature, or (with no feature) an editable new one.
        function addFeatureRow(feature = null) {
            featuresEditRows.querySelector('.features-empty-row')?.remove();
            const isNew = feature === null;
            const featureId = isNew ? nextTempFeatureId-- : feature.id;

            const row = featuresEditRows.insertRow();
            row.dataset.featureId = featureId;
            if (isNew) row.dataset.isNew = 'true';
            row.insertCell();

            const featureCell = row.insertCell();
            let typeSelect = null;
            if (isNew) {
                typeSelect = document.createElement('select');
                typeSelect.className = 'form-select form-select-sm d-inline-block w-auto feature-type-select';
                typeSelect.required = true;
                typeSelect.setAttribute('aria-label', 'Feature type');
                typeSelect.add(new Option('Select a feature type...', ''));
                featureCell.appendChild(typeSelect);
            } else {
                // The feature type's Description is shown only as this hover tooltip.
                const typeName = document.createElement('span');
                typeName.textContent = feature.featureType?.name ?? `FeatureType ${feature.featureTypeId}`;
                typeName.title = feature.featureType?.description ?? '';
                featureCell.appendChild(typeName);
            }
            const marker = document.createElement('span');
            marker.className = 'text-danger fw-bold ms-1 missing-param-marker d-none';
            marker.title = 'Missing parameter values';
            marker.textContent = '*';
            featureCell.appendChild(marker);

            // Optional, so it isn't part of the missing-value check (which only looks at data-model-feature-id inputs).
            const featureNameInput = document.createElement('input');
            featureNameInput.type = 'text';
            featureNameInput.className = 'form-control form-control-sm model-feature-name';
            featureNameInput.placeholder = 'optional';
            featureNameInput.setAttribute('aria-label', 'Feature name');
            featureNameInput.value = feature?.modelFeatureName ?? '';
            row.insertCell().appendChild(featureNameInput);

            const sourceCell = row.insertCell();
            if (isNew) {
                const sourceSelect = document.createElement('select');
                sourceSelect.className = 'form-select form-select-sm w-auto feature-source-select';
                sourceSelect.setAttribute('aria-label', 'Feature source');
                for (const [value, text] of FEATURE_SOURCES) sourceSelect.add(new Option(text, value));
                sourceCell.appendChild(sourceSelect);
            } else {
                sourceCell.textContent = feature.source ?? 'daily';
            }

            const paramsCell = row.insertCell();

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn btn-sm btn-link text-danger p-0';
            removeButton.title = 'Remove feature';
            removeButton.setAttribute('aria-label', 'Remove feature');
            removeButton.innerHTML = "<i class='bi bi-x-lg'></i>";
            removeButton.addEventListener('click', () => removeFeatureRow(row, isNew ? null : featureId));
            const removeCell = row.insertCell();
            removeCell.className = 'text-center';
            removeCell.appendChild(removeButton);

            if (isNew) {
                paramsCell.className = 'text-muted';
                paramsCell.textContent = 'Select a feature type';
                loadFeatureTypes().then(types => {
                    for (const type of types) {
                        const option = new Option(type.name, type.id);
                        option.title = type.description ?? '';
                        option.featureType = type;
                        typeSelect.add(option);
                    }
                }).catch(err => {
                    paramsCell.className = 'text-danger';
                    paramsCell.textContent = `Failed to load feature types: ${err.message}`;
                });
                typeSelect.addEventListener('change', () => {
                    typeSelect.title = typeSelect.selectedOptions[0]?.featureType?.description ?? '';
                    renderParamInputs(paramsCell, featureId, typeSelect.selectedOptions[0]?.featureType ?? null, []);
                    refreshFeatureRows();
                });
                typeSelect.focus();
            } else {
                renderParamInputs(paramsCell, featureId, feature.featureType, feature.modelFeatureParams ?? []);
            }
            return row;
        }

        function renderParamInputs(paramsCell, featureId, featureType, existingParams) {
            paramsCell.replaceChildren();
            paramsCell.className = '';
            if (!featureType) {
                paramsCell.className = 'text-muted';
                paramsCell.textContent = 'Select a feature type';
                return;
            }

            const typeParams = [...(featureType.featureTypeParams ?? [])]
                .sort((a, b) => a.parameterKey.localeCompare(b.parameterKey));
            if (!typeParams.length) {
                paramsCell.className = 'text-muted';
                paramsCell.textContent = 'None';
                return;
            }

            const group = document.createElement('div');
            group.className = 'd-flex flex-wrap gap-2';
            for (const typeParam of typeParams) {
                const existing = existingParams.find(p => p.featureTypeParamId === typeParam.id);
                const inputId = `feature-param-${featureId}-${typeParam.id}`;

                const wrapper = document.createElement('div');
                wrapper.className = 'input-group input-group-sm';
                wrapper.style.width = '11rem';

                const label = document.createElement('label');
                label.className = 'input-group-text';
                label.htmlFor = inputId;
                label.textContent = typeParam.parameterKey;

                const input = document.createElement('input');
                input.type = 'number';
                input.step = '1';
                input.className = 'form-control';
                input.id = inputId;
                input.placeholder = 'not set';
                input.dataset.modelFeatureId = featureId;
                input.dataset.featureTypeParamId = typeParam.id;
                input.value = existing?.paramValue ?? '';

                wrapper.append(label, input);
                group.appendChild(wrapper);
            }
            paramsCell.appendChild(group);
        }

        featuresAddButton.addEventListener('click', () => {
            addFeatureRow().scrollIntoView({ block: 'nearest' });
            refreshFeatureRows();
        });

        // featureId is null for a new (unsaved) row, which just disappears.
        function removeFeatureRow(row, featureId) {
            if (featureId !== null) removedFeatureIds.add(featureId);
            row.remove();
            refreshFeatureRows();
        }

        // Renumbers the rows, marks each feature with a missing type or blank param input, only enables Save
        // once nothing is missing, and summarises pending removals.
        function refreshFeatureRows() {
            let anyMissing = false;
            [...featuresEditRows.rows].forEach((row, i) => {
                const marker = row.querySelector('.missing-param-marker');
                if (!marker) return;
                row.cells[0].textContent = i + 1;
                const typeSelect = row.querySelector('.feature-type-select');
                const missing = (typeSelect && !typeSelect.value)
                    || [...row.querySelectorAll('input[data-model-feature-id]')].some(input => input.value.trim() === '');
                marker.classList.toggle('d-none', !missing);
                marker.title = typeSelect && !typeSelect.value ? 'Select a feature type' : 'Missing parameter values';
                anyMissing ||= missing;
            });
            featuresEditSave.disabled = anyMissing;

            const count = removedFeatureIds.size;
            featuresEditPending.classList.toggle('d-none', count === 0);
            featuresEditPending.textContent = `${count} feature${count === 1 ? '' : 's'} will be deleted on Save.`;
        }

        featuresEditRows.addEventListener('input', refreshFeatureRows);

        featuresEditForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            featuresEditForm.classList.add('was-validated');
            if (!featuresEditForm.checkValidity()) return;

            const params = [...featuresEditRows.querySelectorAll('input[data-model-feature-id]')]
                .map(input => ({
                    modelFeatureId: Number(input.dataset.modelFeatureId),
                    featureTypeParamId: Number(input.dataset.featureTypeParamId),
                    paramValue: Number(input.value)
                }));

            const rows = [...featuresEditRows.rows].filter(row => row.dataset.featureId);
            const nameOf = row => row.querySelector('input.model-feature-name').value.trim() || null;
            const features = rows.filter(row => !row.dataset.isNew).map(row => ({
                modelFeatureId: Number(row.dataset.featureId),
                modelFeatureName: nameOf(row)
            }));
            const newFeatures = rows.filter(row => row.dataset.isNew).map(row => ({
                tempId: Number(row.dataset.featureId),
                featureTypeId: Number(row.querySelector('.feature-type-select').value),
                source: row.querySelector('.feature-source-select').value || null,
                modelFeatureName: nameOf(row)
            }));

            featuresEditSave.disabled = true;
            featuresEditError.classList.add('d-none');
            try {
                const res = await fetch('/Home/UpdateFeatureParams', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ modelConfigId: currentModel.id, params, features, newFeatures, deletedFeatureIds: [...removedFeatureIds] })
                });
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);

                await table.replaceData();
                currentModel = table.getRow(currentModel.id)?.getData() ?? currentModel;
                featuresEditModal.hide();
            } catch (err) {
                featuresEditError.textContent = `Save failed: ${err.message}`;
                featuresEditError.classList.remove('d-none');
            } finally {
                refreshFeatureRows();
            }
        });

        const exportModalEl = document.getElementById('export-modal');
        const exportModal = new bootstrap.Modal(exportModalEl);
        const exportRunning = document.getElementById('export-running');
        const exportMessage = document.getElementById('export-message');
        const exportElapsed = document.getElementById('export-elapsed');
        const exportResult = document.getElementById('export-result');
        const exportNote = document.getElementById('export-note');
        const EXPORT_POLL_MS = 2000;
        let exportPollTimer = null;

        // Polling stops when the popup closes; the export itself carries on server-side, and clicking
        // Export again for the same model just reattaches to the running job.
        exportModalEl.addEventListener('hidden.bs.modal', () => clearTimeout(exportPollTimer));

        async function startFeatureExport(model) {
            clearTimeout(exportPollTimer);
            document.getElementById('export-title').textContent = `Export Features: ${model.modelName}`;
            showExportStatus({ state: 'Running', message: 'Starting export...' });
            exportModal.show();

            try {
                const res = await fetch(`/Home/ExportFeatures/${model.id}`, { method: 'POST' });
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);
                await handleExportStatus(model.id, await res.json());
            } catch (err) {
                showExportStatus({ state: 'Failed', message: err.message });
            }
        }

        async function pollFeatureExport(modelId) {
            try {
                const res = await fetch(`/Home/ExportFeaturesStatus/${modelId}`);
                if (!res.ok) throw new Error((await res.text()) || `request failed with status ${res.status}`);
                await handleExportStatus(modelId, await res.json());
            } catch (err) {
                showExportStatus({ state: 'Failed', message: err.message });
            }
        }

        async function handleExportStatus(modelId, status) {
            showExportStatus(status);
            if (status.state === 'Running') {
                exportPollTimer = setTimeout(() => pollFeatureExport(modelId), EXPORT_POLL_MS);
            } else if (status.state === 'Succeeded') {
                await table.replaceData();
            }
        }

        function showExportStatus(status) {
            const running = status.state === 'Running';
            exportRunning.classList.toggle('d-none', !running);
            exportNote.classList.toggle('d-none', !running);
            exportResult.classList.toggle('d-none', running);

            if (running) {
                exportMessage.textContent = status.message;
                const seconds = status.startedAt ? Math.max(0, Math.floor((Date.now() - new Date(status.startedAt)) / 1000)) : 0;
                exportElapsed.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
                return;
            }

            const succeeded = status.state === 'Succeeded';
            exportResult.classList.toggle('alert-success', succeeded);
            exportResult.classList.toggle('alert-danger', !succeeded);
            exportResult.textContent = succeeded
                ? `features.csv was generated successfully. ${status.message}`
                : `Export failed: ${status.message}`;
        }

        const barDataColumns = [
            {
                title: 'Session Date', field: 'sessionDate',
                formatter: (cell) => {
                    const v = cell.getValue();
                    return v ? `${v.slice(0, 4)}-${v.slice(4, 6)}-${v.slice(6, 8)}` : '';
                }
            },
            { title: 'Bar Count', field: 'barCount', hozAlign: 'right' }
        ];

        // Built lazily on first show: Tabulator's fitColumns layout can't measure
        // a container that's still display:none inside the inactive tab pane.
        let barDataTable = null;
        let instrumentsLoaded = false;
        const instrumentSelect = document.getElementById('bar-data-instrument');

        document.getElementById('trade-data-tab').addEventListener('shown.bs.tab', async () => {
            if (!barDataTable) {
                barDataTable = Defaults.grid.buildGrid('#bar-data-table', barDataColumns, '/Home/BarDataCounts');
            } else {
                barDataTable.redraw(true);
            }

            if (!instrumentsLoaded) {
                instrumentsLoaded = true;
                try {
                    const res = await fetch('/Home/Instruments');
                    if (!res.ok) throw new Error(`request failed with status ${res.status}`);
                    const instruments = await res.json();

                    instrumentSelect.innerHTML = '';
                    for (const instrument of instruments) {
                        const option = document.createElement('option');
                        option.value = instrument;
                        option.textContent = instrument;
                        instrumentSelect.appendChild(option);
                    }
                } catch (err) {
                    instrumentSelect.innerHTML = '<option value="">Failed to load instruments</option>';
                }
            }
        });

        // Keep a stray drop outside the dropzone from navigating the browser to the file.
        window.addEventListener('dragover', (e) => e.preventDefault());
        window.addEventListener('drop', (e) => e.preventDefault());

        const dropzone = document.getElementById('bar-data-dropzone');
        const dropzoneStatus = document.getElementById('bar-data-dropzone-status');

        ['dragenter', 'dragover'].forEach((evt) => dropzone.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.add('bar-data-dropzone-active');
        }));
        ['dragleave', 'drop'].forEach((evt) => dropzone.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.remove('bar-data-dropzone-active');
        }));

        dropzone.addEventListener('drop', async (e) => {
            const files = e.dataTransfer.files;
            if (!files.length) return;

            dropzoneStatus.textContent = `Importing ${files.length} file(s)...`;

            const formData = new FormData();
            for (const file of files) formData.append('files', file);

            try {
                const res = await fetch('/Home/ImportBarData', { method: 'POST', body: formData });
                if (!res.ok) throw new Error(`request failed with status ${res.status}`);

                const results = await res.json();
                const total = results.reduce((sum, r) => sum + r.imported, 0);
                const errors = results.filter(r => r.error).map(r => r.error);
                dropzoneStatus.textContent = `Imported ${total} bar record(s) from ${results.length} file(s).` +
                    (errors.length ? ` Skipped: ${errors.join(' ')}` : '');

                if (barDataTable) barDataTable.setData('/Home/BarDataCounts');
            } catch (err) {
                dropzoneStatus.textContent = `Import failed: ${err.message}`;
            }
        });
    </script>
}
