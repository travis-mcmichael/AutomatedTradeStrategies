            <h2 class="mb-2">Predictions — <span id="predictions-session-date"></span></h2>
            <div id="predictions-table"></div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Predictions: whether each model can run an inference for the current session. A model row expands to its
    // features: a green check when a feature has all the data it needs, otherwise its problems in red.
    // Built on first show (Tabulator can't measure a hidden container); reloaded on later shows.
    const expandedPredictionIds = new Set();

    const issueLines = (issues) => issues.map((issue) => `<div>${Defaults.escapeHtml(issue)}</div>`).join('');

    const featureColumns = [
        { title: 'Feature', field: 'name' },
        { title: 'Type', field: 'featureTypeName' },
        { title: 'Source', field: 'source' },
        {
            title: 'Status', field: 'isReady', headerSort: false,
            formatter: (cell) => {
                const feature = cell.getRow().getData();
                return feature.isReady
                    ? "<i class='bi bi-check-circle-fill text-success' title='Ready'></i>"
                    : `<div class='text-danger'>${issueLines(feature.issues)}</div>`;
            }
        }
    ];

    const predictionColumns = [
        Defaults.grid.expanderColumn(
            (m) => m.features.length > 0 || m.modelIssues.length > 0,
            (m) => expandedPredictionIds.has(m.id),
            (m) => Defaults.grid.toggleExpanded(expandedPredictionIds, m.id)),
        { title: 'Model', field: 'modelName' },
        {
            title: 'Inference Ready', field: 'isReady', hozAlign: 'center',
            formatter: (cell) => cell.getValue()
                ? "<span class='badge text-bg-success'>Ready</span>"
                : "<span class='badge text-bg-danger'>Not ready</span>"
        }
    ];

    // Secondary level: the model-level problems (in red) above a table of its features.
    function predictionRowFormatter(row) {
        const el = row.getElement();
        el.querySelector(':scope > .prediction-subgrid')?.remove();
        const model = row.getData();
        if (!expandedPredictionIds.has(model.id)) return;
        if (model.features.length === 0 && model.modelIssues.length === 0) return;

        const holder = document.createElement('div');
        holder.className = 'prediction-subgrid p-2 ps-4';
        if (model.modelIssues.length > 0) {
            const issues = document.createElement('div');
            issues.className = 'text-danger mb-2';
            issues.innerHTML = issueLines(model.modelIssues);
            holder.appendChild(issues);
        }
        if (model.features.length > 0) {
            const grid = document.createElement('div');
            holder.appendChild(grid);
            new Tabulator(grid, { layout: 'fitColumns', data: model.features, columns: featureColumns });
        }
        el.appendChild(holder);
    }

    const predictionsUrl = '/Home/Predictions';
    let predictionsTable = null;
    document.getElementById('predictions-tab').addEventListener('shown.bs.tab', () => {
        if (!predictionsTable) {
            predictionsTable = Defaults.grid.buildGrid('#predictions-table', predictionColumns, predictionsUrl, {
                pagination: false, height: false,
                rowFormatter: predictionRowFormatter,
                ajaxResponse: (url, params, response) => {
                    document.getElementById('predictions-session-date').textContent = response.sessionDate;
                    return response.models;
                }
            });
        } else {
            predictionsTable.setData(predictionsUrl);
        }
    });

});
</script>
