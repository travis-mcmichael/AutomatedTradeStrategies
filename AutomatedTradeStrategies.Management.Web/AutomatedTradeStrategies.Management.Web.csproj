<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutomatedTrading.Core\AutomatedTrading.Core.csproj" />
  </ItemGroup>

  <!-- Training runs Scripts/mlpipeline.sh from the deployed site, so the scripts are published with it. -->
  <ItemGroup>
    <Content Include="Scripts\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
